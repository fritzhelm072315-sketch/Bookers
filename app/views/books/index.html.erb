<h1>Books</h1>
  <table>
  <thead>
    <tr>
      <th>本のタイトル</th>
      <th>感想</th>
      <th colspan="3"></th>
    </tr>
  </thead>
  <% @books.each do |book| %>
  <tbody> 
  <tr>
    <td><%= book.title %></td>
    <td><%= book.body %></td>
    <td><%= link_to "Show", book_path(book.id) %></td>
    <td><%= link_to "Edit", edit_book_path(book.id) %></td>
    <td><%= link_to "Destroy", book_path(book.id), data: { turbo_method: :delete, turbo_confirm: "Are you sure？" } %></td>
  </tr>
  </tbody>
  <% end %>
  </table>

<h2>New book</h2>

<% if @book.errors.any? %>
  <div id="error"><h2><%= @book.errors.count %> error prohibited this book from being saved:</h2>
  <ul>
    <% @book.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul></div>
<% end %>

<%= form_with model: @book, method: :post do |f| %>
  <div><label>本のタイトル</label></div>
  <div><%= f.text_field :title %></div>
  <div><label>感想</label></div>
  <div><%= f.text_area :body %></div>
  <div><%= f.submit 'Create Book' %></div>
<% end %>