<h1>Editing Book</h1>

<% if @book.errors.any? %>
  <div id="error"><h2><%= @book.errors.count %> error prohibited this book from being saved:</h2>
  <ul>
    <% @book.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul></div>
<% end %>

<%= form_with model: @book, method: :patch do |f| %>
  <div><lebel>本のタイトル</lebel></div>
  <div><%= f.text_field :title %></div>
  <div><lebel>感想</lebel></div>
  <div><%= f.text_area :body %></div>
  <div><%= f.submit 'Update Book' %></div>
<% end %>

<%= link_to "Show", book_path(@book.id) %> | <%= link_to "Back", '/books' %>